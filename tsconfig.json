{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "module": "ESNext"
  },
  "include": ["frontend/**/*.d.ts", "frontend/**/*.ts", "frontend/**/*.svelte", "vite.config.ts"]
}
